# Lab #26 — Environment Variables
# Copy this to .env and fill in values

# ── Database ──────────────────────────────────
# Path to SQLite database file (default: ./data/lab26.db)
DB_PATH=./data/lab26.db

# ── HTTP Server (BONUS) ───────────────────────
# Host and port for the HTTP MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Bearer token for HTTP auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# If not set, a random dev token will be generated and printed on startup
MCP_AUTH_TOKEN=your_secret_token_here

# Rate limit: max requests per minute per token (default: 60)
RATE_LIMIT_RPM=60
